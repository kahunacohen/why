flowchart TD

%% Initial complaints
C1["Chest pain"]
C2["Shortness of breath"]

%% Initial investigative actions
A1["Visual assessment"]
A2["Measure vitals"]

%% Initial complaints motivate actions
C1 -->|motivates| A1
C2 -->|motivates| A1
C1 -->|motivates| A2
C2 -->|motivates| A2

%% Initial observations
O1["Respiratory distress"]
O2["Tachycardia"]
O3["Low oxygen saturation"]

%% Actions produce observations
A1 -->|produces| O1
A2 -->|produces| O2
A2 -->|produces| O3

%% Hypotheses
H1["Respiratory cause"]
H2["Cardiac cause"]
H3["Anxiety-related cause"]

%% Observations support hypotheses
O1 -->|supports| H1
O1 -->|supports| H2

O2 -->|supports| H1
O2 -->|supports| H2
O2 -->|supports| H3

O3 -->|supports| H1
O3 -->|supports| H2

%% Respiratory investigation
A5["Lung auscultation"]
A6["Chest X-ray"]

H1 -->|motivates| A5
H1 -->|motivates| A6

%% Cardiac investigation
A3["ECG"]
A4["Troponin test"]

H2 -->|motivates| A3
H2 -->|motivates| A4

%% Patient history
A7["Detailed patient history"]

H3 -->|motivates| A7
H2 -->|motivates| A7

O5["Family mental health issues"]
A7 -->|produces| O5
O5 -->|supports| H3

%% ECG result
O4["No ST elevation"]
A3 -->|produces| O4
O4 -->|weakens| H2

O6["Normal troponin"]
A4 -->|produces| O6
O6 -->|weakens| H2

O7["Clear chest X-ray"]
A6 -->|produces| O7
O7 -->|weakens| H1
