flowchart TD

%% =====================================================
%% Initial presentation
%% =====================================================

C1["Chest pain"]
C2["Shortness of breath"]

%% =====================================================
%% Initial investigation
%% =====================================================

A1["Visual assessment"]
A2["Measure vitals"]

C1 -->|motivates| A1
C2 -->|motivates| A1

C1 -->|motivates| A2
C2 -->|motivates| A2

%% =====================================================
%% Initial observations
%% =====================================================

O1["Respiratory distress?"]
O2["Tachycardia?"]
O3["Low oxygen saturation?"]

A1 -->|produces| O1

A2 -->|produces| O2
A2 -->|produces| O3

%% =====================================================
%% Initial hypotheses
%% =====================================================

H1["Respiratory cause"]
H2["Cardiac cause"]
H3["Anxiety-related cause"]

O1 -->|supports| H1
O1 -->|supports| H2

O2 -->|supports| H1
O2 -->|supports| H2
O2 -->|supports| H3

O3 -->|supports| H1
O3 -->|supports| H2

%% =====================================================
%% Follow-up actions
%% =====================================================

A3["ECG"]
A4["Troponin test"]

A5["Lung auscultation"]
A6["Chest X-ray"]

A7["Detailed patient history"]

H2 -->|motivates| A3
H2 -->|motivates| A4

H1 -->|motivates| A5
H1 -->|motivates| A6

H2 -->|motivates| A7
H3 -->|motivates| A7

%% =====================================================
%% Follow-up observations
%% =====================================================

O4["No ST elevation"]
O6["Normal troponin"]

O7["Clear chest X-ray"]
O8["Clear breath sounds"]

O5["Family mental health issues"]

A3 -->|produces| O4
A4 -->|produces| O6

A6 -->|produces| O7
A5 -->|produces| O8

A7 -->|produces| O5

%% =====================================================
%% Evidence updates hypotheses
%% =====================================================

O4 -->|weakens| H2
O6 -->|weakens| H2

O7 -->|weakens| H1
O8 -->|weakens| H1

O5 -->|supports| H3

%% =====================================================
%% Unexplained low oxygen saturation
%% =====================================================

A8["Detailed thromboembolic risk history"]

H3 -->|does not explain well| O3
O3 -->|motivates| A8

%% =====================================================
%% Additional risk-factor observations
%% =====================================================

O9["Recent long-haul flight"]
O10["Recent calf pain"]

A8 -->|produces| O9
A8 -->|produces| O10

%% =====================================================
%% Refined hypothesis
%% =====================================================

H4["Pulmonary embolism"]

H4 -->|specializes| H1

O9 -->|supports| H1
O10 -->|supports| H1

O9 -->|supports| H4
O10 -->|supports| H4
A9["CT pulmonary angiography"]
H4 --> |motivates| A9

C1["Pulmonary embolism"]
A9 --> |confirms| C1
