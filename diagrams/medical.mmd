flowchart TD

  %% =========================
  %% INITIAL PRESENTATION
  %% =========================
  subgraph initial["Initial complaints"]
    O1["Chest pain"]
    O2["Shortness of breath"]
    OP["Chest pain + Shortness of breath (combined presentation)"]
  end

  O1 --> OP
  O2 --> OP

  %% =========================
  %% CLINICAL ACTIONS
  %% =========================
  subgraph actions["Clinical actions"]
    A1["Visual triage assessment"]
    A2["Measure vitals"]
  end

  OP -->|motivates| A1
  OP -->|motivates| A2

  %% =========================
  %% OBSERVATIONS
  %% =========================
  subgraph observations["Clinical observations"]

    subgraph visual["Visual triage observations"]
      O6["Difficulty speaking in full sentences"]
      O7["Anxious"]
      O8["Sweating"]
    end

    subgraph vitals["Vital sign observations"]
      O3["Blood pressure: 150/95"]
      O4["Pulse: 110"]
      O5["Temperature: 37.8"]
      O9["Respiratory rate: 24"]
      O10["Oxygen saturation: 93%"]
    end

  end

  A1 --> O6
  A1 --> O7
  A1 --> O8

  A2 --> O3
  A2 --> O4
  A2 --> O5
  A2 --> O9
  A2 --> O10

  %% =========================
  %% DIFFERENTIAL DIAGNOSIS
  %% =========================
  subgraph hypotheses["Differential diagnosis"]
    H1["Pulmonary embolism"]
    H2["Pneumonia"]
    H3["Panic attack"]
    H4["Acute coronary syndrome"]
  end

  %% Combined presentation → hypotheses
  OP -->|suggests| H1
  OP -->|suggests| H2
  OP -->|suggests| H3
  OP -->|suggests| H4

  %% Visual cues → panic / stress pattern
  O6 -->|suggests| H1
  O6 -->|suggests| H2
  O6 -->|suggests| H3
  O6 -->|suggests| H4

  O7 -->|suggests| H3
  O7 -->|suggests| H1
  O7 -->|suggests| H2
  O7 -->|suggests| H4

  O8 -->|suggests| H1
  O8 -->|suggests| H2
  O8 -->|suggests| H3
  O8 -->|suggests| H4

  %% Vital signs → hypotheses (cleaned grouping)
  O3 -->|suggests| H3
  O3 -->|suggests| H4

  O4 -->|suggests| H3

  O5 -->|suggests| H2

  O9 -->|suggests| H1
  O9 -->|suggests| H2
  O9 -->|suggests| H3
  O9 -->|suggests| H4

  O10 -->|suggests| H1
  O10 -->|suggests| H2

  %% =========================
  %% STYLES
  %% =========================
  classDef obs fill:#efe,stroke:#5a5
  classDef action fill:#eef,stroke:#55f
  classDef hyp fill:#ffd,stroke:#aa5

  class O1,O2,OP,O3,O4,O5,O6,O7,O8,O9,O10 obs
  class A1,A2 action
  class H1,H2,H3,H4 hyp
