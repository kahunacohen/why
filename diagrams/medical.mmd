flowchart TD

%% Initital complaints
C1["Chest pain"]
C2["Shortness of breath"]
  

%% Investigative actions"]
A1["Visual assessment"]
A2["Measure vitals"]


%% Initial complaints motivate...
C1 -->|motivates| A1
C2 -->|motivates| A1
C1 -->|motivates| A2
C2 -->|motivates| A2

%% Observations
O1["Respiratory distress"]
O2["Tachycardia"]
O3["Low oxygen saturation"]
  

%% Measuring vitals produces observations
A1 -->|produces| O1
A2 -->|produces| O2
A2 -->|produces| O3

%% Hypotheses
H1["Respiratory cause"]
H2["Cardiac cause"]
H3["Anxiety-related cause"]

O1 -->|supports| H1
O1 -->|supports| H2

O2 -->|supports| H1
O2 -->|supports| H2
O2 -->|supports| H3

O3 -->|supports| H1
O3 -->|supports| H2

A5["Lung auscultation"]
A6["Chest X-ray"]
H1 --> |motivates| A5
H1 --> |motivates| A6
  
A3["ECG"]
A4["Troponin test"]

H2 --> |motivates| A3
H2 --> |motivates| A4

A7["Detailed patient history"]
H3 --> |motivates| A7
H2 --> |motivates| A7

%% What the last test results produce.
%% EEG
O4["No ST elevation"]
A3 --> |produces| O4
O4 --weakens--> H2
